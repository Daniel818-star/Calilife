            sans: ['Inter', 'Tajawal', 'sans-serif'],
            display: ['Bebas Neue', 'sans-serif'],
          },
          colors: {
            primary: '#ff5722',
            primaryHover: '#e64a19',
            primaryLight: '#ff8a65',
            darkBg: '#030303',
            cardDark: 'rgba(18, 18, 18, 0.8)',
            cardLight: 'rgba(255, 255, 255, 0.75)',
          }
