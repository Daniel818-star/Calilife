        let total = 0, count = 0;
        if (this.cart.length === 0) {
          container.innerHTML = `<div class="flex flex-col items-center justify-center h-full text-gray-500 mt-10"><svg class="w-16 h-16 mb-4 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg><span class="font-semibold">${Dictionary[this.lang].cart_empty}</span></div>`;
        } else {
          container.innerHTML = this.cart.map(item => {
            total += item.price * item.quantity; count += item.quantity;
            return `<div class="flex items-center gap-4 bg-gray-50 dark:bg-white/[0.03] p-4 rounded-2xl border border-gray-100 dark:border-white/5 transition hover:border-primary/20"><img src="${item.img}" class="w-20 h-20 object-cover rounded-xl"><div class="flex-1 min-w-0"><h4 class="font-bold text-sm text-gray-900 dark:text-white truncate">${item['name_'+this.lang]}</h4><div class="text-primary font-bold text-sm mt-0.5">$${item.price.toFixed(2)}</div><div class="flex items-center gap-3 mt-2"><button onclick="app.updateQuantity(${item.id},-1)" class="w-7 h-7 flex items-center justify-center bg-gray-200 dark:bg-white/10 rounded-lg hover:bg-gray-300 dark:hover:bg-white/20 transition text-gray-800 dark:text-white text-sm font-bold">−</button><span class="text-sm font-bold text-gray-900 dark:text-white w-4 text-center">${item.quantity}</span><button onclick="app.updateQuantity(${item.id},1)" class="w-7 h-7 flex items-center justify-center bg-gray-200 dark:bg-white/10 rounded-lg hover:bg-gray-300 dark:hover:bg-white/20 transition text-gray-800 dark:text-white text-sm font-bold">+</button></div></div><button onclick="app.removeFromCart(${item.id})" class="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 rounded-xl transition"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button></div>`;
          }).join('');
        }
        totalDisplay.innerText = `$${total.toFixed(2)}`;
        if (count > 0) { countBadge.innerText = count; countBadge.classList.remove('hidden'); }
        else countBadge.classList.add('hidden');
      }
      checkout() {
        if (this.cart.length === 0) return;
        if (!this.user) {
          this.toggleCart(); this.openAuthModal('login');
          this.toast(this.lang === 'en' ? 'Please login to checkout' : 'يرجى تسجيل الدخول لإتمام الشراء');
          return;
        }
        this.cart = []; this.saveCart(); this.renderCart(); this.toggleCart();
        this.toast(this.lang === 'en' ? 'Order placed successfully! 🎉' : 'تم تأكيد طلبك بنجاح! 🎉');
      }

      async renderSkills(filter) {
        const grid = document.getElementById('skillsGrid');
        grid.innerHTML = Array(3).fill('<div class="glass-card rounded-3xl h-96 skeleton"></div>').join('');
        await new Promise(r => setTimeout(r, 500));
        grid.innerHTML = '';
        
        const categories = ['static', 'dynamic'];
        const dict = Dictionary[this.lang];
        const levelColors = { beginner: 'from-emerald-500 to-emerald-400', intermediate: 'from-amber-500 to-amber-400', advanced: 'from-red-500 to-red-400' };

        categories.forEach(cat => {
          const filtered = DB.skills.filter(s => s.category === cat && (filter === 'all' || s.level === filter));
          if (filtered.length === 0) return;

          const sectionTitle = document.createElement('div');
          sectionTitle.className = 'col-span-full mt-12 mb-8 fade-in-up';
          sectionTitle.innerHTML = `<h3 class="text-3xl font-display text-primary border-l-4 border-primary pl-4">${dict[cat + '_skills']}</h3>`;
          grid.appendChild(sectionTitle);

          filtered.forEach((skill, i) => {
            const card = document.createElement('div');
            card.className = `glass-card border-glow rounded-3xl overflow-hidden group fade-in-up stagger-${i % 3 + 1}`;
            card.innerHTML = `
              <div class="h-60 overflow-hidden relative">
                <img src="${skill.img}" alt="${skill['name_'+this.lang]}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy">
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                <div class="absolute top-4 right-4 bg-gradient-to-r ${levelColors[skill.level]} px-3 py-1 text-[10px] font-bold rounded-full text-white uppercase tracking-widest shadow-lg">
                  ${dict['filter_'+skill.level]}
                </div>
                <div class="absolute bottom-4 left-4 right-4">
                  <h3 class="text-2xl font-bold font-display tracking-wide text-white drop-shadow-lg">${skill['name_'+this.lang]}</h3>
                </div>
              </div>
              <div class="p-6">
                <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">${skill['desc_'+this.lang]}</p>
                <div class="space-y-2">
                  <div class="flex justify-between text-xs font-bold text-gray-500 uppercase tracking-wider">
                    <span>${dict.difficulty}</span>
                    <span class="text-primary">${skill.diff}%</span>
                  </div>
                  <div class="w-full bg-gray-200 dark:bg-white/5 rounded-full h-2 overflow-hidden">
                    <div class="progress-fill bg-gradient-to-r from-primary to-primaryLight h-2 rounded-full" style="width:${skill.diff}%"></div>
                  </div>
                </div>
              </div>
            `;
            grid.appendChild(card);
          });
        });

        setTimeout(() => {
          grid.querySelectorAll('.fade-in-up').forEach(el => el.classList.add('visible'));
        }, 50);
        this.initMagneticBtns();
        this.initTiltCards();
      }

      async renderProducts() {
        const grid = document.getElementById('productsGrid');
        grid.innerHTML = Array(4).fill('<div class="glass-card rounded-3xl h-80 skeleton"></div>').join('');
        await new Promise(r => setTimeout(r, 500));

        grid.innerHTML = DB.products.map((p, i) => `
          <div class="glass-card border-glow rounded-3xl overflow-hidden group p-5 fade-in-up stagger-${i % 4 + 1} flex flex-col">
            <div class="h-52 overflow-hidden rounded-2xl mb-5 relative">
              <img src="${p.img}" alt="${p['name_'+this.lang]}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy">
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              ${p.badge ? `<div class="absolute top-3 left-3 product-badge">${p.badge}</div>` : ''}
            </div>
            <h3 class="text-lg font-bold mb-1 text-gray-900 dark:text-white">${p['name_'+this.lang]}</h3>
            <div class="flex items-center justify-between mt-auto">
              <span class="text-primary font-bold text-2xl font-display">$${p.price}</span>
              <button onclick="app.addToCart(${p.id})" class="magnetic-btn w-11 h-11 rounded-xl bg-primary/10 hover:bg-gradient-to-r hover:from-primary hover:to-primaryLight text-primary hover:text-white transition-all flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              </button>
            </div>
          </div>
        `).join('');

        setTimeout(() => {
          grid.querySelectorAll('.fade-in-up').forEach(el => el.classList.add('visible'));
        }, 50);
        this.initMagneticBtns();
      }

      toast(msg) {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = 'toast';
        toast.innerHTML = `<span>${msg}</span><button onclick="this.parentElement.remove()" class="ml-4 opacity-50 hover:opacity-100">&times;</button>`;
        container.appendChild(toast);
        setTimeout(() => toast.classList.add('show'), 10);
        setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 500); }, 4000);
      }

      openAuthModal(mode) {
        this.authMode = mode;
        const modal = document.getElementById('authModal');
        modal.classList.remove('hidden');
        this.updateAuthModalUI();
      }
      closeAuthModal() {
        document.getElementById('authModal').classList.add('hidden');
      }
      switchAuthMode() {
        this.authMode = this.authMode === 'login' ? 'signup' : 'login';
        this.updateAuthModalUI();
      }
      updateAuthModalUI() {
        const isLogin = this.authMode === 'login';
        document.getElementById('authTitle').innerText = isLogin ? Dictionary[this.lang].btn_login : Dictionary[this.lang].btn_signup;
        document.getElementById('authSubtitle').innerText = isLogin ? 'Welcome back, athlete!' : 'Start your journey today!';
        document.getElementById('nameField').classList.toggle('hidden', isLogin);
        document.getElementById('btnAuthText').innerText = isLogin ? Dictionary[this.lang].btn_login : Dictionary[this.lang].btn_signup;
        document.getElementById('modalSwitchText').innerText = isLogin ? "Don't have an account?" : "Already have an account?";
        document.getElementById('modalSwitchBtn').innerText = isLogin ? Dictionary[this.lang].btn_signup : Dictionary[this.lang].btn_login;
      }
      handleAuth(e) {
        e.preventDefault();
        const email = document.getElementById('inputEmail').value;
        const name = document.getElementById('inputName').value || email.split('@')[0];
        this.user = { name, email };
        localStorage.setItem('calilife_user', JSON.stringify(this.user));
        this.updateAuthUI();
        this.closeAuthModal();
        this.toast(this.lang === 'en' ? `Welcome, ${name}!` : `مرحباً، ${name}!`);
      }
      logout() {
        this.user = null;
        localStorage.removeItem('calilife_user');
        this.updateAuthUI();
        this.toast(this.lang === 'en' ? 'Logged out successfully' : 'تم تسجيل الخروج بنجاح');
      }
      updateAuthUI() {
        const container = document.getElementById('authContainer');
        if (this.user) {
          container.innerHTML = `
            <div class="flex items-center gap-4">
              <div class="hidden sm:block text-right">
                <div class="text-xs font-bold text-gray-400 uppercase tracking-widest">Athlete</div>
                <div class="text-sm font-bold">${this.user.name}</div>
              </div>
              <button onclick="app.logout()" class="px-6 py-3 rounded-xl bg-white/5 border border-white/10 hover:bg-red-500 hover:text-white transition-all text-sm font-bold uppercase tracking-widest" data-i18n="btn_logout">Logout</button>
            </div>
          `;
        } else {
          container.innerHTML = `
            <button onclick="app.openAuthModal('login')" class="px-6 py-3 rounded-xl bg-white/5 border border-white/10 hover:bg-primary hover:text-white transition-all text-sm font-bold uppercase tracking-widest" data-i18n="btn_login">Login</button>
          `;
        }
      }

      setupEventListeners() {
        document.querySelectorAll('.filter-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active', 'bg-gradient-to-r', 'from-primary', 'to-primaryLight', 'text-white', 'shadow-lg', 'shadow-primary/30'));
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.add('bg-gray-100', 'dark:bg-white/5', 'text-gray-700', 'dark:text-gray-300'));
            
            btn.classList.add('active', 'bg-gradient-to-r', 'from-primary', 'to-primaryLight', 'text-white', 'shadow-lg', 'shadow-primary/30');
            btn.classList.remove('bg-gray-100', 'dark:bg-white/5', 'text-gray-700', 'dark:text-gray-300');
            this.renderSkills(btn.dataset.filter);
          });
        });
      }
    }

    const app = new CalilifeApp();
  </script>
</body>
</html>
