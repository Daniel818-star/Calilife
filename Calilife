    const DB = {
      skills: [
        { id: 1, name_en: "Push-Up", name_ar: "تمرين الضغط", level: "beginner", diff: 20, img: "https://images.unsplash.com/photo-1598971639058-fab3c3109a00?w=500&q=80" },
        { id: 2, name_en: "Pull-Up", name_ar: "السحب", level: "beginner", diff: 40, img: "https://images.unsplash.com/photo-1526506114642-a6652c78f5f6?w=500&q=80" },
        { id: 3, name_en: "Dip", name_ar: "الغمس", level: "beginner", diff: 35, img: "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=500&q=80" },
        { id: 4, name_en: "Pistol Squat", name_ar: "القرفصاء المسدسية", level: "intermediate", diff: 60, img: "https://images.unsplash.com/photo-1434682881908-b43d0467b798?w=500&q=80" },
        { id: 5, name_en: "Muscle-Up", name_ar: "موسكل أب", level: "intermediate", diff: 75, img: "https://images.unsplash.com/photo-1599058917212-d750089bc07e?w=500&q=80" },
        { id: 6, name_en: "Front Lever", name_ar: "الرافعة الأمامية", level: "advanced", diff: 85, img: "https://images.unsplash.com/photo-1517836357463-d25dfeac3438?w=500&q=80" },
        { id: 7, name_en: "Planche", name_ar: "البلانش", level: "advanced", diff: 95, img: "https://images.unsplash.com/photo-1538805060514-97d9cc17730c?w=500&q=80" }
      ],
      products: [
        { id: 1, name_en: "Pro Pull-Up Bar", name_ar: "بار احترافي", price: 49.99, img: "https://images.unsplash.com/photo-1584735935682-2f2b69dff9d2?w=500&q=80" },
        { id: 2, name_en: "Wooden Parallettes", name_ar: "بارليت خشبي", price: 59.99, img: "https://images.unsplash.com/photo-1620188526357-ff08e03ae266?w=500&q=80" },
        { id: 3, name_en: "Gymnastics Rings", name_ar: "حلقات جمباز", price: 39.99, img: "https://images.unsplash.com/photo-1517344654924-dc24513149ba?w=500&q=80" },
        { id: 4, name_en: "Liquid Chalk", name_ar: "طباشير سائل", price: 14.99, img: "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=500&q=80" }
      ]
    };

    // --- Core Application Class ---
    class CalilifeApp {
      constructor() {
        this.lang = localStorage.getItem('calilife_lang') || 'en';
        this.theme = localStorage.getItem('calilife_theme') || 'dark';
        this.user = JSON.parse(localStorage.getItem('calilife_user')) || null;
        this.cart = JSON.parse(localStorage.getItem('calilife_cart')) || [];
        this.authMode = 'login';
        
        this.init();
      }

      init() {
        this.applyTheme();
        this.applyLanguage();
        this.updateAuthUI();
        this.renderCart();
        this.setupEventListeners();
        this.renderSkills('all');
        this.renderProducts();
        this.initScrollAnimations();
      }

      // -- UI State Management --
      toggleTheme() {
        this.theme = this.theme === 'dark' ? 'light' : 'dark';
        localStorage.setItem('calilife_theme', this.theme);
        this.applyTheme();
      }

      applyTheme() {
        const html = document.documentElement;
        if (this.theme === 'dark') {
          html.classList.add('dark');
        } else {
          html.classList.remove('dark');
        }
      }

      toggleLanguage() {
        this.lang = this.lang === 'en' ? 'ar' : 'en';
        localStorage.setItem('calilife_lang', this.lang);
        this.applyLanguage();
        this.renderSkills(document.querySelector('.filter-btn.active').dataset.filter);
        this.renderProducts();
        this.renderCart();
      }

      applyLanguage() {
        const html = document.documentElement;
        html.dir = this.lang === 'ar' ? 'rtl' : 'ltr';
        html.lang = this.lang;
        document.getElementById('langToggle').innerText = this.lang === 'en' ? 'ع' : 'EN';
        
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (Dictionary[this.lang][key]) {
            el.innerHTML = Dictionary[this.lang][key];
          }
        });
        
        // Also update the modal strings if open
        this.updateModalUI();
      }

      // -- Cart System --
      toggleCart() {
        const html = document.documentElement;
        const overlay = document.getElementById('cartOverlay');
        
        html.classList.toggle('cart-open');
        if (html.classList.contains('cart-open')) {
          overlay.classList.remove('hidden');
        } else {
          overlay.classList.add('hidden');
        }
      }

      addToCart(id) {
        const product = DB.products.find(p => p.id === id);
        if (!product) return;
        
        const existing = this.cart.find(item => item.id === id);
        if (existing) {
          existing.quantity++;
        } else {
          this.cart.push({ ...product, quantity: 1 });
        }
        
        this.saveCart();
        this.renderCart();
        
        const productName = this.lang === 'en' ? product.name_en : product.name_ar;
        this.toast(this.lang === 'en' ? `${productName} added to cart!` : `تمت إضافة ${productName} للسلة!`);
      }

      removeFromCart(id) {
        this.cart = this.cart.filter(item => item.id !== id);
        this.saveCart();
        this.renderCart();
      }

      updateQuantity(id, change) {
        const item = this.cart.find(i => i.id === id);
        if (item) {
          item.quantity += change;
          if (item.quantity <= 0) {
            this.removeFromCart(id);
          } else {
            this.saveCart();
            this.renderCart();
          }
        }
      }

      saveCart() {
        localStorage.setItem('calilife_cart', JSON.stringify(this.cart));
      }

      renderCart() {
        const container = document.getElementById('cartItems');
        const countBadge = document.getElementById('cartCount');
        const totalDisplay = document.getElementById('cartTotal');
        
        let total = 0;
        let count = 0;
        
        if (this.cart.length === 0) {
          container.innerHTML = `<div class="text-center text-gray-500 mt-10 font-medium">${Dictionary[this.lang].cart_empty}</div>`;
        } else {
          container.innerHTML = this.cart.map(item => {
            total += item.price * item.quantity;
            count += item.quantity;
            return `
              <div class="flex items-center gap-4 bg-gray-50 dark:bg-gray-800/50 p-3 rounded-xl border border-gray-100 dark:border-gray-700">
                <img src="${item.img}" class="w-16 h-16 object-cover rounded-lg">
                <div class="flex-1">
                  <h4 class="font-bold text-sm text-gray-900 dark:text-white line-clamp-1">${item['name_' + this.lang]}</h4>
                  <div class="text-primary font-bold text-sm">$${item.price}</div>
                  <div class="flex items-center gap-3 mt-2">
                    <button onclick="app.updateQuantity(${item.id}, -1)" class="w-6 h-6 flex items-center justify-center bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition text-gray-800 dark:text-white">-</button>
                    <span class="text-sm font-bold text-gray-900 dark:text-white">${item.quantity}</span>
                    <button onclick="app.updateQuantity(${item.id}, 1)" class="w-6 h-6 flex items-center justify-center bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition text-gray-800 dark:text-white">+</button>
                  </div>
                </div>
                <button onclick="app.removeFromCart(${item.id})" class="p-2 text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 rounded-lg transition">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
              </div>
            `;
          }).join('');
        }
        
        totalDisplay.innerText = `$${total.toFixed(2)}`;
        
        if (count > 0) {
          countBadge.innerText = count;
          countBadge.classList.remove('hidden');
        } else {
          countBadge.classList.add('hidden');
        }
      }

      checkout() {
        if (this.cart.length === 0) return;
        if (!this.user) {
          this.toggleCart();
          this.openAuthModal('login');
          this.toast(this.lang === 'en' ? 'Please login to checkout' : 'يرجى تسجيل الدخول لإتمام الشراء');
          return;
        }
        
        this.cart = [];
        this.saveCart();
        this.renderCart();
        this.toggleCart();
        this.toast(this.lang === 'en' ? 'Order placed successfully! 🎉' : 'تم تأكيد طلبك بنجاح! 🎉');
      }

      // -- Rendering Grids --
      async renderSkills(filter) {
        const grid = document.getElementById('skillsGrid');
        grid.innerHTML = Array(3).fill('<div class="glass-card rounded-2xl h-80 skeleton"></div>').join(''); 

        await new Promise(r => setTimeout(r, 400));

        const filtered = filter === 'all' ? DB.skills : DB.skills.filter(s => s.level === filter);
        const langDict = Dictionary[this.lang];

        grid.innerHTML = filtered.map(skill => `
          <div class="glass-card rounded-3xl overflow-hidden group fade-in-up visible">
            <div class="h-56 overflow-hidden relative">
              <img src="${skill.img}" alt="${skill['name_' + this.lang]}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
              <div class="absolute top-4 right-4 bg-black/70 backdrop-blur px-3 py-1 text-xs font-bold rounded-full text-white uppercase tracking-wider border border-white/10">
                ${langDict['filter_' + skill.level]}
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-2xl font-bold mb-4 font-display tracking-wide">${skill['name_' + this.lang]}</h3>
              <div class="space-y-2">
                <div class="flex justify-between text-xs font-bold text-gray-500 uppercase">
                  <span>${langDict.difficulty}</span>
                  <span>${skill.diff}%</span>
                </div>
                <div class="w-full bg-gray-200 dark:bg-gray-800 rounded-full h-2 overflow-hidden">
                  <div class="bg-primary h-2 rounded-full" style="width: ${skill.diff}%"></div>
                </div>
              </div>
            </div>
          </div>
        `).join('');
      }

      async renderProducts() {
        const grid = document.getElementById('productsGrid');
        grid.innerHTML = Array(4).fill('<div class="glass-card rounded-2xl h-72 skeleton"></div>').join('');
        
        await new Promise(r => setTimeout(r, 400));

        grid.innerHTML = DB.products.map(p => `
          <div class="glass-card rounded-3xl overflow-hidden group p-4 fade-in-up visible flex flex-col">
            <div class="h-48 overflow-hidden rounded-2xl mb-4 relative">
              <img src="${p.img}" alt="${p['name_' + this.lang]}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
            </div>
            <h3 class="text-xl font-bold mb-1">${p['name_' + this.lang]}</h3>
            <p class="text-primary font-bold text-lg mb-4">$${p.price}</p>
            <button onclick="app.addToCart(${p.id})" class="mt-auto w-full py-3 rounded-xl border-2 border-primary text-primary font-bold hover:bg-primary hover:text-white transition group-hover:shadow-lg shadow-primary/30">
              ${Dictionary[this.lang].add_cart}
            </button>
          </div>
        `).join('');
      }

      // -- Modals & Auth --
      openAuthModal(mode) {
        this.authMode = mode;
        const modal = document.getElementById('authModal');
        const content = document.getElementById('authModalContent');
        
        modal.classList.remove('hidden');
        void modal.offsetWidth; 
        content.classList.remove('scale-95', 'opacity-0');
        content.classList.add('scale-100', 'opacity-100');

        this.updateModalUI();
      }

      closeAuthModal() {
        const content = document.getElementById('authModalContent');
        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');
        setTimeout(() => document.getElementById('authModal').classList.add('hidden'), 300);
      }

      switchAuthMode() {
        this.authMode = this.authMode === 'login' ? 'signup' : 'login';
        this.updateModalUI();
      }

      updateModalUI() {
        const dict = Dictionary[this.lang];
        const isLogin = this.authMode === 'login';
        
        document.getElementById('modalTitle').innerText = isLogin ? (this.lang === 'en' ? 'LOGIN' : 'تسجيل الدخول') : (this.lang === 'en' ? 'SIGN UP' : 'حساب جديد');
        document.getElementById('nameField').style.display = isLogin ? 'none' : 'block';
        document.getElementById('inputName').required = !isLogin;
        
        document.getElementById('btnAuthText').innerText = isLogin ? dict.btn_login : dict.btn_signup;
        document.getElementById('modalSwitchText').innerText = isLogin ? (this.lang === 'en' ? "Don't have an account?" : "ليس لديك حساب؟") : (this.lang === 'en' ? "Already have an account?" : "لديك حساب بالفعل؟");
        document.getElementById('modalSwitchBtn').innerText = isLogin ? dict.btn_signup : dict.btn_login;
      }

      handleAuth(e) {
        e.preventDefault();
        const email = document.getElementById('inputEmail').value;
        const name = document.getElementById('inputName').value;

        // Mock auth login
        this.user = { name: this.authMode === 'login' ? email.split('@')[0] : name, email };
        localStorage.setItem('calilife_user', JSON.stringify(this.user));
        
        this.toast(this.lang === 'en' ? `Welcome, ${this.user.name}!` : `أهلاً بك، ${this.user.name}!`);
        this.updateAuthUI();
        this.closeAuthModal();
      }

      logout() {
        this.user = null;
        localStorage.removeItem('calilife_user');
        this.updateAuthUI();
        this.toast(this.lang === 'en' ? 'Logged out successfully' : 'تم تسجيل الخروج بنجاح');
      }

      updateAuthUI() {
        const authArea = document.getElementById('authArea');
        const userArea = document.getElementById('userArea');
        
        if (this.user) {
          // Hide login/signup entirely
          authArea.className = 'hidden';
          // Show user profile area on desktop
          userArea.className = 'hidden md:flex items-center gap-3';
          document.getElementById('userNameDisplay').innerText = this.user.name;
        } else {
          // Show login/signup on desktop
          authArea.className = 'hidden md:flex items-center gap-3';
          // Hide user profile area entirely
          userArea.className = 'hidden';
        }

        // Mobile Menu Area Update
        document.getElementById('mobileAuthArea').innerHTML = this.user 
          ? `<span class="block py-2 font-bold text-primary">${this.user.name}</span><button onclick="app.logout()" class="block py-2 text-left text-red-500 font-bold hover:bg-red-50 dark:hover:bg-red-500/10 transition rounded px-2">${Dictionary[this.lang].btn_logout}</button>`
          : `<button onclick="app.openAuthModal('login'); document.getElementById('mobileMenu').classList.add('hidden');" class="block py-2 text-center font-bold border border-gray-200 dark:border-gray-700 rounded-lg px-4 mb-2 hover:bg-gray-50 dark:hover:bg-gray-800 transition">${Dictionary[this.lang].btn_login}</button><button onclick="app.openAuthModal('signup'); document.getElementById('mobileMenu').classList.add('hidden');" class="block py-2 text-center font-bold bg-primary text-white rounded-lg px-4 shadow-lg shadow-primary/30 hover:bg-primaryHover transition">${Dictionary[this.lang].btn_signup}</button>`;
      }

      toast(msg) {
        const container = document.getElementById('toastContainer');
        const el = document.createElement('div');
        el.className = 'toast';
        el.innerHTML = `<span class="font-bold">${msg}</span>`;
        container.appendChild(el);
        setTimeout(() => el.classList.add('show'), 10);
        setTimeout(() => {
          el.classList.remove('show');
          setTimeout(() => el.remove(), 400);
        }, 3000);
      }

      // -- Events & Animations --
      setupEventListeners() {
        document.getElementById('themeToggle').addEventListener('click', () => this.toggleTheme());
        document.getElementById('langToggle').addEventListener('click', () => this.toggleLanguage());
        document.getElementById('authForm').addEventListener('submit', (e) => this.handleAuth(e));
        
        document.getElementById('mobileMenuBtn').addEventListener('click', () => {
          const menu = document.getElementById('mobileMenu');
          menu.classList.toggle('hidden');
        });

        document.querySelectorAll('.filter-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            document.querySelectorAll('.filter-btn').forEach(b => {
              b.classList.remove('bg-primary', 'text-white', 'shadow-lg');
              b.classList.add('bg-gray-200', 'dark:bg-gray-800', 'text-gray-700', 'dark:text-gray-300');
            });
            e.target.classList.remove('bg-gray-200', 'dark:bg-gray-800', 'text-gray-700', 'dark:text-gray-300');
            e.target.classList.add('bg-primary', 'text-white', 'shadow-lg');
            this.renderSkills(e.target.dataset.filter);
          });
        });
      }

      initScrollAnimations() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });

        document.querySelectorAll('.fade-in-up').forEach(el => observer.observe(el));
      }
    }

    // Initialize App
    const app = new CalilifeApp();
  </script>
